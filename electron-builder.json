{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.aigc.canvas",
  "productName": "AIGC CANVAS",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraResources": [
    {
      "from": "resources/comfyui-workflows",
      "to": "comfyui-workflows"
    },
    {
      "from": "resources/claude-plugin",
      "to": "claude-plugin"
    }
  ],
  "mac": {
    "icon": "resources/app-icons/icon.icns",
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "icon": "resources/app-icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "installerIcon": "resources/app-icons/icon.ico",
    "uninstallerIcon": "resources/app-icons/icon.ico",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "electron-vite",
    "repo": "electron-vite-react",
    "releaseType": "release"
  },
  "asarUnpack": [
    "node_modules/@openai/codex-*/**"
  ]
}
